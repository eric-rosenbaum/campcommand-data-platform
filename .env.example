# Local Postgres (docker compose)
CAMPCOMMAND_DB_HOST=localhost
CAMPCOMMAND_DB_PORT=5443
CAMPCOMMAND_DB_NAME=campcommand

# Production: Snowflake
# DBT_TARGET=snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=SVC_CAMPCOMMAND_DBT
# SNOWFLAKE_PRIVATE_KEY_PATH=
# CAMPCOMMAND_WAREHOUSE_URL=snowflake://SVC_CAMPCOMMAND_LOADER@<account>/CAMPCOMMAND/RAW?warehouse=LOADING&role=LOADER

# Client error report emails (optional; reports are only logged without it)
# CAMPCOMMAND_SMTP_HOST=
# CAMPCOMMAND_SMTP_PORT=587
# CAMPCOMMAND_SMTP_USER=
# CAMPCOMMAND_SMTP_PASSWORD=
