<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ client.name }}: {{ feed_title }} upload</title>
<style>
  :root { --ink: #1d2433; --muted: #5b6475; --line: #e3e6ec; --bg: #f7f8fa; --warn: #a35200; --bad: #b42318; --ok: #1a7f37; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 860px; margin: 0 auto; padding: 32px 20px 64px; }
  header p { color: var(--muted); margin: 4px 0 0; }
  h1 { font-size: 22px; margin: 0; }
  h2 { font-size: 17px; margin: 0 0 4px; }
  .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 24px 0; }
  .stat { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; }
  .stat b { display: block; font-size: 24px; }
  .stat span { color: var(--muted); font-size: 13px; }
  .stat.loaded b { color: var(--ok); }
  .stat.held b { color: var(--warn); }
  section { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; margin: 16px 0; }
  section.bad { border-color: #f1b8b3; }
  .count { color: var(--muted); font-weight: normal; }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; table-layout: fixed; }
  th:nth-child(1) { width: 56px; }
  th:nth-child(2) { width: 170px; }
  th, td { text-align: left; padding: 7px 8px; border-top: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
  td.row { white-space: nowrap; color: var(--muted); }
  td.value { overflow-wrap: anywhere; }
  code { background: var(--bg); padding: 1px 5px; border-radius: 4px; }
  .next { background: #fff8eb; border-color: #f5d9a8; }
  footer { color: var(--muted); font-size: 13px; margin-top: 32px; }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ client.name }}: {{ feed_title }} upload</h1>
    <p>File <code>{{ batch.source_file }}</code></p>
  </header>

  {% if file_problems %}
  <section class="bad">
    <h2>Nothing from this file was loaded</h2>
    {% for problem in file_problems %}
    <p>{{ problem.message }}</p>
    {% endfor %}
    <p>Fix the file and upload it again. Your previous data is unchanged.</p>
  </section>
  {% else %}
  <div class="summary">
    <div class="stat"><b>{{ "{:,}".format(batch.rows_received) }}</b><span>rows received</span></div>
    <div class="stat loaded"><b>{{ "{:,}".format(batch.rows_loaded) }}</b><span>loaded</span></div>
    <div class="stat held"><b>{{ "{:,}".format(batch.rows_quarantined) }}</b><span>held back to fix</span></div>
  </div>

  {% if groups %}
  <section class="next">
    <h2>What to do</h2>
    <p>
      The rows below weren't loaded. Everything else was.
      {% if csv_name %}<code>{{ csv_name }}</code> has just those rows, laid out like your file, with a note on each.{% endif %}
      Fix them in your spreadsheet and export again. You can send the whole file; rows we already have won't be duplicated.
    </p>
  </section>
  {% endif %}

  {% for group in groups %}
  <section>
    <h2>{{ group.title }}{% if group.column %}: {{ group.column }}{% endif %} <span class="count">({{ group.count }})</span></h2>
    <table>
      <thead><tr><th>Row</th><th>Value</th><th>Problem</th></tr></thead>
      <tbody>
      {% for v in group.examples %}
        <tr><td class="row">{{ v.source_row }}</td><td class="value">{{ v.value if v.value is not none else "(blank)" }}</td><td>{{ v.message }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% if group.more %}<p class="count">and {{ group.more }} more in the CSV.</p>{% endif %}
  </section>
  {% endfor %}
  {% endif %}

  {% if unmapped_columns %}
  <section>
    <h2>Columns we ignored</h2>
    <p>These columns aren't part of your setup, so we skipped them: {{ unmapped_columns | join(", ") }}. If one of them should be loaded, let us know.</p>
  </section>
  {% endif %}

  <footer>
    Sent to {{ client.contact_name }} &lt;{{ client.contact_email }}&gt; · batch {{ batch.batch_id[:8] }} · {{ generated_at.strftime("%b %-d, %Y %-I:%M %p") }}
  </footer>
</main>
</body>
</html>
